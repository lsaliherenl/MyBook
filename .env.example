# Copy this file to .env and fill in the values. Never commit .env.

# Google Books API (server-side only — never expose to the browser)
GOOGLE_BOOKS_API_KEY=

# Supabase (Project Settings → Database / API)
# Pooled connection for the app (Supavisor, port 6543)
DATABASE_URL=
# Direct connection for Prisma migrations (port 5432)
DIRECT_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
