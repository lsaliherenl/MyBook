# Copy this file to .env and fill in the values. Never commit .env.

# Google Books API (server-side only — never expose to the browser)
GOOGLE_BOOKS_API_KEY=

# Supabase database (Project Settings → Database). Use the pooler host; the direct db host is IPv6-only.
SUPABASE_DB_PASSWORD=
# Pooled connection for the app (Supavisor transaction mode, port 6543)
DATABASE_URL=
# Session connection for Prisma migrations (port 5432)
DIRECT_URL=

# Supabase API (Project Settings → API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy JWT "service_role" key (Project Settings → API Keys → Legacy) — Storage uploads, server only
SUPABASE_SERVICE_ROLE_KEY=

# Web → API (server side)
API_URL=http://localhost:4000/api

# Dev only: set to true if outgoing connections are slow because IPv6 DNS lookups hang
FORCE_IPV4=false
